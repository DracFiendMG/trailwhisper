# -------------------------------------------------------------
# TrailWhisper Environment Configuration
# -------------------------------------------------------------

# Port configurations
PORT=4000
WEB_PORT=3000
TABPFN_SERVICE_URL=http://localhost:8000

# Best Use of Gemma ($200)
# Supports Ollama (local gemma-2-2b-it or gemma-2-9b-it) or OpenAI-compatible endpoint (vLLM / Hugging Face / Groq)
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL_NAME=gemma2:2b

# Best Use of ElevenLabs ($100)
# API key and preferred nature guide voice ID (e.g., George, Charlotte, or custom whisper voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Best Use of Sentry ($100)
# Sentry DSN for AI Agent Tracing with OpenTelemetry
SENTRY_DSN=https://sample_dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# TabPFN Microservice settings (Python)
TABPFN_DEVICE=cpu
TABPFN_N_ENSEMBLE=4
