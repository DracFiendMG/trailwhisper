# -------------------------------------------------------------
# TrailWhisper Environment Configuration
# -------------------------------------------------------------

# Port configurations
PORT=4000
WEB_PORT=3000
TABPFN_SERVICE_URL=http://localhost:8000

# Best Use of Gemma ($200) - OpenRouter SDK with Free Open-Weight Gemma
# Powered by OpenRouter SDK (@openrouter/sdk) with Google's Gemma 4 26B (Free Tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMMA_MODEL_NAME=google/gemma-4-26b-a4b-it:free
# Optional local fallback runner (Ollama / vLLM)
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_API_KEY=ollama

# Best Use of ElevenLabs ($100)
# API key and preferred nature guide voice ID (e.g., George, Charlotte, or custom whisper voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Best Use of Sentry ($100)
# Sentry DSN for AI Agent Tracing with OpenTelemetry
SENTRY_DSN=https://sample_dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# TabPFN Microservice settings (Python)
TABPFN_DEVICE=cpu
TABPFN_N_ENSEMBLE=4
TABPFN_API_KEY=tabpfn_sk_1234
